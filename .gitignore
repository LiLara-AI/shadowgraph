node_modules/
.npm-cache/
.shadowgraph/
coverage/
benchmark/results/
*.log
__pycache__/
*.py[cod]
.DS_Store
.env

# Local assistant / editor tool state. None of these hold public product
# configuration -- the tracked client templates live in `integrations/` -- and
# they accumulate session, cache and backup data that must never be published.
# `.npmignore` already excluded them from the tarball; this keeps them out of
# the repository as well.
.claude/
.codex/
.cursor/
.hermes/
.serena/

# Local-only handoff and debug notes. Only sanitized, product-relevant handoff
# information is tracked under docs/.
#
# These in-repository ignore rules are a FALLBACK against an accidental `git
# add`, not the preferred place to keep raw internal material: anything here is
# one forced add or one edited rule away from publication. Raw handoffs, session
# state, backups, logs and machine notes belong outside the repository entirely,
# in the local workspace (`npm run local:workspace:init`). See CONTRIBUTING.md.
.local-handoff/
